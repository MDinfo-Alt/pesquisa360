# Login (obrigatório — o servidor não sobe sem estes dois)
AUTH_USER=pesquisador
AUTH_PASSWORD=troque-esta-senha

PORT=3333

# Desenvolvimento local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pesquisa360
DB_USER=postgres
DB_PASSWORD=postgres

# Produção: quando DATABASE_URL existe, as cinco variáveis acima são ignoradas.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Só para hosts com certificado autoassinado (Postgres interno do Render).
# Aceita qualquer certificado — não use em conexões pela internet aberta.
# DB_SSL_SEM_VERIFICAR=true
